# IUCN Red List API v4 Token (For Live Conservation Assessment Sync)
# Get your token from: https://api.iucnredlist.org/
VITE_IUCN_API_TOKEN=your_iucn_api_token_here

# CARTO Basemap API Key (For Voyager Map Tiles)
# Get your key from: https://carto.com/
VITE_CARTO_API_KEY=your_carto_basemap_key_here

# Google Gemini API Key (From Google AI Studio: https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
