{
  "name": "vietnam-birds-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node scripts/test-summary.js",
    "test:full": "vitest run",
    "test:data": "vitest run src/data/validateData.test.ts",
    "data:verify": "node scripts/verify-dataset.js",
    "data:audit": "node scripts/data-pipeline/audit-species-input.js",
    "species:harvest": "node scripts/data-pipeline/harvest-species.js",
    "species:verify": "node scripts/data-pipeline/verify-species-candidate.js",
    "species:commit": "node scripts/data-pipeline/commit-species-candidate.js",
    "species:add": "node scripts/data-pipeline/add-species.js"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
